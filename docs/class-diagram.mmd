classDiagram

    class TransactionType {
        <<enumeration>>
        Income
        Expense
    }

    class Category {
        <<enumeration>>
        Salary
        Food
        Shopping
        Entertainment
        Health
        Housing
        Transport
        Other
    }

    class Transaction {
        +Guid Id
        +DateTimeOffset Timestamp
        +TransactionType Type
        +string Description
        +decimal Amount
        +Category Category
    }

    class TransactionAddedEventArgs {
        +Transaction Transaction
    }

    class IStorageService {
        <<interface>>
        +SaveTransaction(Transaction) void
        +LoadRange(DateOnly, DateOnly) IReadOnlyList~Transaction~
        +RemoveById(Guid) bool
    }

    class StorageException {
        +string FilePath
    }

    class StorageService {
        -string _dataDirectory
        -JsonSerializerOptions _jsonOptions
        +StorageService(string)
        +SaveTransaction(Transaction) void
        +LoadRange(DateOnly, DateOnly) IReadOnlyList~Transaction~
        +RemoveById(Guid) bool
    }

    class TransactionService {
        -IStorageService _storage
        +TransactionAdded event
        +TransactionService(IStorageService)
        +Add(TransactionType, string, decimal, Category) Transaction
        +Remove(Guid) bool
        +Query(DateOnly, DateOnly) IEnumerable~Transaction~
    }

    class LoggerService {
        -string _logFilePath
        +LoggerService(TransactionService, string)
    }

    class MenuAction {
        <<enumeration>>
        AddTransaction
        RemoveTransaction
        RangeReport
        CategoryReport
        Exit
    }

    class ConsoleUI {
        -IAnsiConsole _console
        -TransactionService _transactionService
        +ConsoleUI(IAnsiConsole, TransactionService)
        +Run() void
    }

    class Program {
        <<entry point>>
        +Main() void
    }

    Program ..> StorageService : creates
    Program ..> TransactionService : creates
    Program ..> LoggerService : creates
    Program ..> ConsoleUI : creates & runs

    StorageService ..|> IStorageService : implements
    StorageException --|> Exception : extends
    TransactionService --> IStorageService : uses
    TransactionService ..> Transaction : creates
    TransactionService ..> TransactionAddedEventArgs : raises
    LoggerService --> TransactionService : subscribes (TransactionAdded)
    StorageService ..> Transaction : JSON serialisation
    StorageService ..> StorageException : throws
    Transaction --> TransactionType
    Transaction --> Category

    ConsoleUI --> TransactionService : calls
    ConsoleUI ..> Transaction : reads
    ConsoleUI ..> MenuAction : uses
